  "framework": "nextjs",
  "buildCommand": "cd frontend && npm run build",
  "installCommand": "cd frontend && npm install",
  "outputDirectory": "frontend/out",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://94.156.237.122:7392/api/:path*" },
    { "source": "/config", "destination": "https://94.156.237.122:7392/config" },
    { "source": "/health", "destination": "https://94.156.237.122:7392/health" }
  ]
}
